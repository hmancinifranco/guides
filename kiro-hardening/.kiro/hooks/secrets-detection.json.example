{
  "version": "v1",
  "hooks": [
    {
      "name": "Secrets Detection (PreToolUse)",
      "trigger": "PreToolUse",
      "description": "Bloquea escrituras de archivos que parezcan contener secretos (claves, tokens, contraseñas) antes de que se ejecuten fs_write/str_replace/fs_append.",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "bash .kiro/hooks/scripts/detect-secrets.sh",
        "timeout": 30
      }
    }
  ]
}